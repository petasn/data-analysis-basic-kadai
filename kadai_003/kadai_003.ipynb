      "source": [
        "#インポート\n",
        "import numpy as np\n",
        "\n",
        "#配列に格納\n",
        "A = np.array([[0, 1], [2, 3],[4, 5]])\n",
        "B = np.array([[0, 1, 2, 3], [4, 5, 6, 7]])\n",
        "\n",
        "#行列の積を計算する\n",
        "C = np.dot(A, B)\n",
        "\n",
        "#結果を表示する\n",
        "print(f\"行列の積={C}\")\n",
        "\n",
        "#最大値を求める\n",
        "D = C.max()\n",
        "\n",
        "#結果を表示する\n",
        "print(f\"最大値={D}\")"
      ],
      "metadata": {
